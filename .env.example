# ==============================================================================
# AI Quality Gatekeeper Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration (Multi-Provider Support)
# ------------------------------------------------------------------------------
# Supported providers: gemini (default), openai, anthropic, ollama
LLM_PROVIDER=gemini

# --- Option A: Google Gemini (Default, Zero-Config Free Tier Available) ---
# Generate your API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here
# Alternative: GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Models for Free and Standard Tier:
# - GEMINI_FLASH_MODEL: gemini-3.5-flash-lite (fast, high throughput, zero quota errors)
# - GEMINI_PRO_MODEL: gemini-3.5-flash-lite (or gemini-3.1-pro-preview for paid tier)
# - GEMINI_EMBEDDING_MODEL: models/gemini-embedding-001 (3072-dimensional vector index)
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Option B: OpenAI ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_FLASH_MODEL=gpt-4o-mini
# OPENAI_PRO_MODEL=gpt-4o

# --- Option C: Anthropic Claude ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_FLASH_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_PRO_MODEL=claude-3-5-sonnet-20241022

# --- Option D: Local Ollama (Self-Hosted / Offline) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_FLASH_MODEL=llama3.2
# OLLAMA_PRO_MODEL=qwen2.5-coder:14b

# ------------------------------------------------------------------------------
# 2. SonarQube & SonarCloud Integration (Optional but Recommended)
# ------------------------------------------------------------------------------

# Scenario A: Personal / Small Projects (SonarCloud - Free for Public GitHub Repos)
# 1. Sign up at https://sonarcloud.io with your GitHub account.
# 2. Import your repository and find your Project Key (e.g., "my-user_my-repo").
# 3. Generate a User Token under: My Account -> Security -> Generate Token.
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=your_sonarcloud_user_token_here
SONAR_PROJECT_KEY=your_organization_or_user_project_key
# PR_NUMBER= # Optional: specify pull request number to filter issues by PR

# Scenario B: Corporate / Enterprise Projects (Self-Hosted SonarQube)
# Uncomment these if connecting to a private internal SonarQube server:
# SONAR_HOST_URL=http://sonar.internal.company.com:9000
# SONAR_TOKEN=sqp_your_corporate_token_here
# SONAR_PROJECT_KEY=internal-project-key

# ------------------------------------------------------------------------------
# 3. GitHub Integration (Optional)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) for posting automated PR comments or CLI runs
GITHUB_TOKEN=your_github_token_here
# Backblaze B2 (S3-compatible API)
# Set true only when running with Backblaze B2. Local development uses in-memory storage.
B2_ENABLED=false
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=your-private-bucket
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key

# Gmail API (notificação por e-mail da decisão sobre o PDF, US-08)
# Set true apenas com credenciais OAuth2 válidas (escopo gmail.send). Em dev nenhum e-mail é enviado.
GMAIL_ENABLED=false
GMAIL_SENDER=conta.remetente@gmail.com
GMAIL_CLIENT_ID=your-oauth-client-id
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# Development identity adapter. Replace with the real authentication provider.
VITE_USER_ID=client-1
VITE_USER_ROLE=CLIENT
VITE_PROJECT_ID=replace-with-project-id
